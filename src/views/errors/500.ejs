<%- include('../partials/header') %>
<main>
    <h1>Something Went Wrong</h1>
    <p>We are experiencing technical difficulties. Our team has been notified and is working to fix the issue.</p>
    <p>Return to the <a href="/">homepage</a> to continue browsing.</p>
    
    <% 
        const currentEnv = typeof NODE_ENV !== 'undefined' ? NODE_ENV : (typeof locals.NODE_ENV !== 'undefined' ? locals.NODE_ENV : 'production');
    %>

    <% if (currentEnv === 'development') { %>
        <details open>
            <summary>Error Details (Development Only)</summary>
            <% if (typeof error !== 'undefined' && error) { %>
                <pre><%= error %></pre>
            <% } %>
            <% if (typeof stack !== 'undefined' && stack) { %>
                <pre><%= stack %></pre>
            <% } %>
        </details>
    <% } %>
</main>
<%- include('../partials/footer') %>